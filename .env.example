# Cantábria — variáveis de ambiente (copie para .env e preencha).
#
#   cp .env.example .env
#
# O .env NÃO é versionado (ver .gitignore). Nunca comite valores reais.
#
# Convenção:
#   CLICKHOUSE_USER / CLICKHOUSE_PASSWORD
#       credencial de APLICAÇÃO (runtime, read-only). Consumida pelo adapter
#       via bootstrapper E pelo users.xml (from_env) para criar o usuário
#       `cantabria_app` dentro do container.
#   CLICKHOUSE_SEED_USER / CLICKHOUSE_SEED_PASSWORD
#       credencial do setup/seed (escrita + DDL).
#   CLICKHOUSE_DEFAULT_PASSWORD
#       senha do usuário `default` do container (admin local, só loopback).
#
# O seed usa apenas o `cantabria_seed` (CREATE DATABASE, DDL e carga). Os
# escopos são definidos por perfil no users.xml — usuários XML não aceitam
# GRANT, então nenhum passo usa o `default`.

# --- Conexão ----------------------------------------------------------------
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=cantabria

# --- Credencial de aplicação (runtime, read-only) ---------------------------
CLICKHOUSE_USER=cantabria_app
CLICKHOUSE_PASSWORD=change-me-app

# --- Credencial do setup/seed (escrita + DDL) -------------------------------
CLICKHOUSE_SEED_USER=cantabria_seed
CLICKHOUSE_SEED_PASSWORD=change-me-seed

# --- Usuário `default` (admin local do container) ---------------------------
CLICKHOUSE_DEFAULT_USER=default
CLICKHOUSE_DEFAULT_PASSWORD=change-me-default

# --- Aplicação ---------------------------------------------------------------
# Caminho do config.yaml (o .env é carregado ANTES dele, então vale aqui).
CONFIG_PATH=config.yaml
# Caminho do .env quando não está na raiz (raro; o padrão é ./.env subindo).
DOTENV_PATH=
# Diretório dos dados governados (catálogo, prompts, capabilities).
# Vazio = checkout atual (ou /app/data na imagem Docker).
CANTABRIA_DATA_DIR=
# Overrides finos (vazios = derivados do data dir ou do config.yaml).
CANTABRIA_CATALOGS_DIR=
CANTABRIA_INTERPRETATION_PROMPTS_DIR=
CANTABRIA_INSIGHT_PROMPTS_DIR=
CANTABRIA_DOCUMENTAL_PROMPTS_DIR=
CANTABRIA_CAPABILITIES_FILE=
# Chainlit: no host use 127.0.0.1; no container/devcontainer use 0.0.0.0.
CHAINLIT_HOST=127.0.0.1
CHAINLIT_PORT=8000
# Segredo que assina os tokens de sessão do Chainlit. OBRIGATÓRIO quando o
# login local (`auth.local_login_enabled: true` no config.yaml) ou o OAuth
# Google está ligado; sem login pode ficar vazio. Gere com:
#   chainlit create-secret
CHAINLIT_AUTH_SECRET=

# --- Stores da Fase 3 (profile `stores` do compose; ADR 0003) ---------------
# MongoDB: o app USA quando `MONGO_URL` existe (histórico, planos, resultados,
# artefatos e outbox de eventos); sem ela — ou com o servidor fora do ar — roda
# em memória e o `/ready` reporta. Dentro do compose o app aponta para o
# serviço (`mongodb:27017`, ver compose.yaml); aqui, para uso no host.
# Qdrant: RAG semântico quando a seção `embeddings` existe no config.yaml;
# MinIO: documentos de referência (Value Object Store) e artefatos. Sem
# qualquer um deles a busca continua lexical (BM25) e a demo roda offline.
MONGO_URL=mongodb://127.0.0.1:27017/cantabria
QDRANT_URL=http://127.0.0.1:6333
# API S3 do MinIO (console web em http://127.0.0.1:9003).
MINIO_ENDPOINT=http://127.0.0.1:9002
# Bucket dos documentos de referência gerados/ingeridos (`make ingest`).
MINIO_BUCKET=cantabria-docs
# Credenciais raiz do MinIO (mínimo 8 caracteres na senha). Troque antes de subir.
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
