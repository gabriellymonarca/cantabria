# Cantábria — Langfuse stack secrets (copy to .env and fill in).
#
#   cp infrastructure/.env.example infrastructure/.env
#   ./scripts/langfuse_up.sh
#
# infrastructure/.env is gitignored. Never commit real values. Generate the
# random ones with: openssl rand -hex 32
#
# The app itself reads these keys from config.yaml (observability block),
# not from this file; copy the rendered INIT_PROJECT keys there.

# PostgreSQL (Langfuse transactional store)
POSTGRES_PASSWORD=change-me-postgres

# ClickHouse (Langfuse analytics store)
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-clickhouse

# Redis (Langfuse queue)
LANGFUSE_REDIS_AUTH=change-me-redis

# MinIO (Langfuse event/media store)
LANGFUSE_MINIO_USER=change-me-minio-user
LANGFUSE_MINIO_PASSWORD=change-me-minio-password

# Langfuse application secrets (random hex, 64 chars recommended)
LANGFUSE_SALT=change-me-salt
LANGFUSE_ENCRYPTION_KEY=change-me-encryption-key-64-hex-chars
LANGFUSE_NEXTAUTH_SECRET=change-me-nextauth-secret

# Browser URL of the Langfuse UI
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Headless bootstrap: project API keys created on first boot.
# Generate fresh ones per environment; do NOT reuse the project keys that
# were once hard-coded in this repository (CI rejects any non-placeholder key).
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE-ME

# Headless bootstrap: admin user created on first boot.
LANGFUSE_INIT_ADMIN_EMAIL=admin@cantabria.local
LANGFUSE_INIT_ADMIN_PASSWORD=change-me-admin
