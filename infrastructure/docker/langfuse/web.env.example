# langfuse-web only. Loaded after common.env, so later values win.
#
# TEMPLATE: rendered by scripts/langfuse_up.sh from infrastructure/.env
# (see infrastructure/.env.example). The rendered web.env is gitignored;
# never commit real secrets.

NEXTAUTH_URL=${LANGFUSE_NEXTAUTH_URL:-http://localhost:3000}
NEXTAUTH_SECRET=${LANGFUSE_NEXTAUTH_SECRET}

# Media is fetched by the browser, which reaches MinIO on the published host
# port; server-side uploads use the internal endpoint from common.env.
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9090
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://langfuse-minio:9000

# Headless initialization: creates the organization, the Cantabria project
# with fixed API keys, and the admin user on the first boot. Copy the rendered
# INIT_PROJECT keys into observability.public_key/secret_key in config.yaml.
LANGFUSE_INIT_ORG_ID=cantabria
LANGFUSE_INIT_ORG_NAME=Cantabria
LANGFUSE_INIT_PROJECT_ID=cantabria
LANGFUSE_INIT_PROJECT_NAME=Cantabria
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=${LANGFUSE_INIT_PROJECT_PUBLIC_KEY}
LANGFUSE_INIT_PROJECT_SECRET_KEY=${LANGFUSE_INIT_PROJECT_SECRET_KEY}
LANGFUSE_INIT_USER_EMAIL=${LANGFUSE_INIT_ADMIN_EMAIL}
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=${LANGFUSE_INIT_ADMIN_PASSWORD}
